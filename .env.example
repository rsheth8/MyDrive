# Optional: live toll totals via TollGuru (https://tollguru.com/toll-api)
TOLLGURU_API_KEY=

# Expo Go on a physical phone (use your Mac's LAN IP, not localhost)
# EXPO_PUBLIC_API_URL=http://192.168.1.x:8000

# Optional: Mapbox — better autocomplete + turn-by-turn (https://www.mapbox.com/)
# MAPBOX_ACCESS_TOKEN=pk.your_token_here

# Optional: self-hosted OSRM (default uses public router.project-osrm.org)
# OSRM_BASE_URL=https://your-osrm-server
